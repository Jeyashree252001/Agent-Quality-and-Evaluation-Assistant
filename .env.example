# Evaluation Assistant Configuration
# Copy this file to .env to configure options

# Evaluation Mode: "hybrid" (deterministic + model), "deterministic_only", or "offline_simulation"
EVAL_MODE=hybrid

# LLM Judge Configuration (Optional - offline heuristics will be used if no API key is supplied)
LLM_PROVIDER=offline
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Strictness settings
DETERMINISTIC_STRICT=true
MIN_MODEL_CONFIDENCE_THRESHOLD=0.80

# Report generation
OUTPUT_DIR=reports
